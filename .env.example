# ==============================================================================
# TradePulse Pro — Convex All Gas Hackathon Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Placed in .env.local)
# ------------------------------------------------------------------------------
# Generated automatically when you run `npx convex dev`
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# ------------------------------------------------------------------------------
# 2. CONVEX CLOUD BACKEND ENVIRONMENT VARIABLES
# These must be set in your Convex Cloud deployment using:
#   npx convex env set <NAME> <VALUE>
# ------------------------------------------------------------------------------

# [SPONSOR: OpenAI] Primary structured extraction & bid leveling pipeline
# Get from: https://platform.openai.com/api-keys
# Set via:  npx convex env set OPENAI_API_KEY "sk-proj-..."
OPENAI_API_KEY=

# [SPONSOR: Firecrawl] Autonomous Texas subcontractor search & website scraping
# Claim 20,000 credits via hackathon registration, get key from https://firecrawl.dev
# Set via:  npx convex env set FIRECRAWL_API_KEY "fc-..."
FIRECRAWL_API_KEY=
# Optional: Webhook signing secret from Firecrawl dashboard -> Project Settings / Advanced -> Webhooks.
# If unset, @firecrawl/firecrawl-convex component operates in resilient poll watchdog mode.
# Set via:  npx convex env set FIRECRAWL_WEBHOOK_SECRET "whsec_..."
FIRECRAWL_WEBHOOK_SECRET=

# [SPONSOR: AgentMail] Dynamic programmatic trade RFQ inboxes & 2-way email routing
# Get API key from: https://agentmail.to
# Set via:  npx convex env set AGENTMAIL_API_KEY "am_..."
AGENTMAIL_API_KEY=

# AgentMail webhook Svix signing secret
# Setup: Run `npm run webhook:setup` to auto-register/retrieve, or get from AgentMail dashboard -> Webhooks
# Point webhook to: https://<your-deployment>.convex.site/agentmail/webhook
# Note: If unset, TradePulse Pro operates in resilient fallback mode and still accepts inbound mail!
# Set via:  npx convex env set AGENTMAIL_WEBHOOK_SECRET "whsec_..."
AGENTMAIL_WEBHOOK_SECRET=

# [OPTIONAL MULTI-MODEL ALTERNATIVES]
# Google Vertex AI SDK / REST (Enterprise GCP project-based flow, no AI Studio prepay needed)
# Set via:  npx convex env set VERTEX_PROJECT_ID "my-gcp-project"
# Set via:  npx convex env set VERTEX_ACCESS_TOKEN "$(gcloud auth print-access-token)"
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-3.8-flash
VERTEX_ACCESS_TOKEN=
VERTEX_API_KEY=

# Google Gemini AI Studio API Key (Alternative for AI Studio users)
GEMINI_API_KEY=

# Anthropic Claude Sonnet 5 API Key (for forensic legal contract analysis)
ANTHROPIC_API_KEY=

